  { "id": "C14", "text": "주유에게 병선을 손보라 전해. 먼저 치지 마라.", "intent": "command", "actions": ["naval-drill"], "restrictions": ["no-first-strike"] },
  { "id": "C15", "text": "먼저 공격하지 말고 수군 정비만 하라.", "intent": "command", "actions": ["naval-drill"], "restrictions": ["no-first-strike"] },
