  { "id": "C18", "text": "주유에게 함대를 정비시키고 싶다. 그 지시의 초안을 만들어라.", "intent": "command", "actions": ["naval-drill"], "restrictions": [] },
  { "id": "C19", "text": "수군 정비를 주유 장군께 맡기도록.", "intent": "command", "actions": ["naval-drill"], "restrictions": [] },
