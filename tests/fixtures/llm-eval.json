  { "id": "C09", "text": "배들을 정돈하고 수병들이 채비를 갖추게 주유에게 일러라.", "intent": "command", "actions": ["naval-drill"], "restrictions": [] },
  { "id": "C10", "text": "주유 장군에게 강동 수군 준비 태세를 다듬도록 하라.", "intent": "command", "actions": ["naval-drill"], "restrictions": [] },
  { "id": "C11", "text": "주유에게 수군 정비를 시키되 먼저 공격하지 마.", "intent": "command", "actions": ["naval-drill"], "restrictions": ["no-first-strike"] },
